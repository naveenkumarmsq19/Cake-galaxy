NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Optional comma-separated storefront origins (Pages URL and custom domain). Overrides WEB_ORIGIN.
WEB_ORIGINS=
MONGODB_URI=mongodb://127.0.0.1:27017/cake_galaxy
COOKIE_SECURE=false
TRUST_PROXY=0
# Set these once to create the first Super Admin, then remove them after startup.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
DELIVERY_FEE_PAISE=4900
DEV_OTP_ENABLED=true
# Temporary customer flow testing: enable only for one phone and set a private six-digit code in Render.
TEST_MODE_ENABLED=false
TEST_PHONE=
TEST_OTP_CODE=
# Live Cash on Delivery. Requires merchant identity, invoice/receipt settings,
# CATALOG_APPROVED=true, and POLICIES_APPROVED=true. No Razorpay keys needed.
COD_ENABLED=false
# Choose whatsapp for WhatsApp-only customer login, even if an old SMS template exists.
CUSTOMER_OTP_CHANNEL=whatsapp
MSG91_AUTH_KEY=
# Real customer SMS verification: use the OTP template ID from MSG91 OTP dashboard.
# Requires Indian DLT entity, sender ID and approved SMS content mapped in MSG91.
# When set, the SMS OTP API is used before WhatsApp OTP for real customers.
MSG91_SMS_OTP_TEMPLATE_ID=
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_OTP_TEMPLATE_NAME=
MSG91_WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# Optional, only if MSG91 specifically requires a template namespace.
MSG91_WHATSAPP_OTP_TEMPLATE_NAMESPACE=
MSG91_WHATSAPP_TEMPLATE_NAME=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CATALOG_APPROVED=false
POLICIES_APPROVED=false
# Set false only when the seller is legitimately unregistered for GST.
# Non-GST: MERCHANT_GSTIN must be blank, GST_RATE_PERCENT must be 0, and
# checkout issues a payment receipt (not a GST tax invoice).
MERCHANT_GST_REGISTERED=true
MERCHANT_GSTIN=
MERCHANT_LEGAL_NAME=
GST_RATE_PERCENT=0

# Enable only AFTER all 198 product gallery images are uploaded to ImageKit.
IMAGEKIT_GALLERIES_ENABLED=false

# Borzo stays OFF until the test booking, webhook and pickup branch are verified.
# Rotate screenshot-exposed tokens. Keep all secrets only in the backend.
BORZO_ENABLED=false
BORZO_ENV=test
BORZO_API_TOKEN=
BORZO_CALLBACK_SECRET=
BORZO_PICKUP_PHONE=
# Comma-separated codes from the verified Branch records; fail closed without this value.
BORZO_APPROVED_BRANCH_CODES=
# Set only if using a Borzo-linked bank card for paying courier charges.
BORZO_BANK_CARD_ID=
BORZO_PAYMENT_METHOD=balance
# Maximum quoted shipping cost in PAISE (e.g. 15000 = INR 150).
BORZO_MAX_COST_PAISE=
BORZO_COD_ENABLED=false
BORZO_ALLOW_TEST_ORDERS=false
BORZO_THERMOBOX_ENABLED=false
